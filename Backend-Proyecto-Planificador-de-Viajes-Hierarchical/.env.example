# Modelo LLM a usar
MODEL=gpt-5.1

# Clave de OpenAI
OPENAI_API_KEY=sk-...

# Clave de Tavily (motor de búsqueda de los agentes). Gratis en https://tavily.com
TAVILY_API_KEY=tvly-...

# Token de la Plataforma de CrewAI (Settings -> Integrations en app.crewai.com)
# Necesario para la integración con Google Calendar.
CREWAI_PLATFORM_INTEGRATION_TOKEN=PK_...

# Respaldo (opcional): si OpenAI responde "sin credito" (429 insufficient_quota),
# se repite esa llamada con Gemini 3.5 Flash via Vertex AI en este proyecto de GCP
# (con la API aiplatform.googleapis.com habilitada).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Credenciales: archivo de ADC o de cuenta de servicio con rol "Vertex AI User".
# Si no la pones, se usan las de `gcloud auth application-default login`.
# OJO: no definas GEMINI_API_KEY ni GOOGLE_API_KEY o CrewAI ignorara Vertex.
GOOGLE_APPLICATION_CREDENTIALS=

# Observabilidad con Langfuse (opcional). Sin estas dos claves la app arranca
# igual, solo que sin trazas. Las sacas de Settings -> API Keys de tu proyecto.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Region del proyecto: EU https://cloud.langfuse.com | US https://us.cloud.langfuse.com
# o la URL de tu Langfuse self-hosted.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
